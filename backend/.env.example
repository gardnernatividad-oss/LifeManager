# Use DATABASE_URL in production. postgresql:// and postgres:// are normalized
# to the installed psycopg SQLAlchemy driver.
DATABASE_URL=postgresql://user:password@database-host:5432/lifemanager

# Local development may use these five values instead of DATABASE_URL.
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=lifemanager
# DB_USER=postgres
# DB_PASSWORD=replace-me

# Required. Generate a unique, high-entropy value of at least 32 characters.
SECRET_KEY=replace-with-a-long-random-production-secret
ACCESS_TOKEN_EXPIRE_MINUTES=30
ALGORITHM=HS256

# JSON array. Add the deployed frontend origin here; never use a wildcard.
CORS_ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

SQL_ECHO=false
TASK_BULK_MAX_OCCURRENCES=1000
